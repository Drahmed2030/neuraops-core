# NeuraOps — Environment Variables Template
# Copy to .env.local and fill in real values.
# NEVER commit .env.local — it is git-ignored.
#
# ⚠  If ANY of these values were ever committed to git history,
#    rotate them immediately even after this remediation.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Used ONLY in src/lib/supabase/admin.ts — never in the generic server client.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY

# ── Meta Pixel ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=YOUR_PIXEL_ID

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
