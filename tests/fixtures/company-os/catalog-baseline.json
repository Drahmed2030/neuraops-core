    },
    {
      "name": "agent_tasks_qa_state_check",
      "table": "agent_tasks",
      "definition": "CHECK ((qa_state = ANY (ARRAY['NOT_REVIEWED'::text, 'PASS'::text, 'HOLD'::text, 'ESCALATE'::text, 'FAIL'::text])))"
    },
    {
      "name": "agent_tasks_risk_level_check",
