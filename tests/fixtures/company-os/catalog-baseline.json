    },
    {
      "name": "agent_tasks_lifecycle_state_check",
      "table": "agent_tasks",
      "definition": "CHECK ((lifecycle_state = ANY (ARRAY['LEGACY_PENDING'::text, 'DRAFT'::text, 'READY'::text, 'WAITING_APPROVAL'::text, 'APPROVED'::text, 'EXECUTING'::text, 'QA_REVIEW'::text, 'COMPLETED'::text, 'HELD'::text, 'REJECTED'::text, 'CANCELLED'::text, 'EXPIRED'::text])))"
    },
